# Dashboard sem login: acesso aberto a quem tiver o endereço.
# A JT_API_KEY é usada exclusivamente no servidor para consultar a VM.

# JT Server API (Cloudflare Tunnel) -> PostgreSQL jt_indicadores.
# A chave deve ficar no backend, nunca em HTML/JS ou no GitHub.
JT_API_URL=https://jt-api.rockettechbr.com.br
JT_API_KEY=
JT_API_CACHE_SECONDS=60
